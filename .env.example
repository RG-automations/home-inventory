# Skopiuj do `.env` (`cp .env.example .env`) i uzupelnij. Plik `.env` jest w .gitignore.
# UWAGA: zmienne EXPO_PUBLIC_* trafiaja do kodu JS aplikacji i sa WIDOCZNE dla kazdego
# uzytkownika. Nigdy nie wpisuj tu kluczy prywatnych ani hasel.

# Adres Twojej instancji PocketBase (z https://, bez koncowego "/").
# Lokalnie: http://localhost:8090   (emulator Androida: http://10.0.2.2:8090)
EXPO_PUBLIC_POCKETBASE_URL=http://localhost:8090

# Tylko dla skryptow pomocniczych (NIE czytane przez aplikacje):
# PB_SUPERUSER_EMAIL=admin@example.com
# PB_SUPERUSER_PASSWORD=
